@page
@model ITHCA0__Global_Events.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container">
    <h2>Reset Password</h2>

    @if (!Model.QuestionVisible)
    {
        //Step 1: Enter Email
        <form method="post" asp-page-handler="FindEmail">
            <label>Enter your Email Address:</label>
            <input type="email" asp-for="Email" class="input-field"/>
            <br /><br />
            <p style="color:red;">@Model.ErrorMessage</p>
            <button type="submit" class="btn">Find Account</button>
        </form>
    }
    else
    {
        //Step 2: Answer Security Question
        <form method="post" asp-page-handler="ResetPassword">
            <input type="hidden" asp-for="Email"/>
            <p><strong>Security Question:</strong> @Model.SecurityQuestion</p>

            <label>Your Answer:</label>
            <input type="text" asp-for="SecurityAnswer" class="input-field"/>
            <br /><br />

            <label>New Password:</label>
            <input type="password" asp-for="NewPassword" class="input-field"/>
            <br /><br />

            <p style="color:red;">@Model.ErrorMessage</p>
            <p style="color:green;">@Model.SuccessMessage</p>
            <button type="submit" class="btn">Reset Password</button>
        </form>
    }

    <br />
    <a href="/Login">Back to Login</a>
</div>
